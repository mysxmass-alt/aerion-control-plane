NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://panel.example.com
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://aerion:strong-password@127.0.0.1:3306/aerion
AERION_NODE_AGENT_URL=http://127.0.0.1:8787
AERION_NODE_AGENT_TOKEN=replace-with-a-long-random-agent-token

# Magic-link email delivery via Resend
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Aerion <login@example.com>

# Optional existing OAuth compatibility
VITE_APP_ID=aerion-control-plane
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
